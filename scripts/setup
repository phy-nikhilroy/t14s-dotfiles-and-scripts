#!/bin/sh

DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

link() {
    src="$1"
    dest="$2"

    mkdir -p "$(dirname "$dest")"

    if [ -L "$dest" ]; then
        if [ "$(readlink "$dest")" = "$src" ]; then
            printf "${GREEN}  ok${NC}  %s\n" "$dest"
            return
        else
            printf "${YELLOW}  skip${NC} %s -> already symlinked elsewhere (%s)\n" "$dest" "$(readlink "$dest")"
            return
        fi
    fi

    if [ -e "$dest" ]; then
        printf "${RED}  skip${NC} %s -> plain file/directory exists, remove it manually first\n" "$dest"
        return
    fi

    ln -s "$src" "$dest"
    printf "${GREEN}  link${NC} %s -> %s\n" "$dest" "$src"
}

echo "Dotfiles: $DOTFILES"
echo ""
echo "Linking configs..."
link "$DOTFILES/alacritty" "$HOME/.config/alacritty"
link "$DOTFILES/kitty"     "$HOME/.config/kitty"
link "$DOTFILES/bspwm"     "$HOME/.config/bspwm"
link "$DOTFILES/sxhkd"     "$HOME/.config/sxhkd"
link "$DOTFILES/polybar"   "$HOME/.config/polybar"
link "$DOTFILES/nvim"      "$HOME/.config/nvim"

echo ""
echo "Linking scripts..."
link "$DOTFILES/scripts/maintain" "$HOME/.local/bin/maintain"

echo ""
echo "Done."
